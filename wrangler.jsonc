{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exunreg26",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exunreg26",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "COOKIE_SECURE": "false",
    "ADMIN_EMAILS": "exun@dpsrkp.net"
  }
}
