{
  "name": "ExunReg26",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply exunreg26 --local",
    "db:migrate:remote": "wrangler d1 migrations apply exunreg26 --remote"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "drizzle-orm": "^0.44.6"
  },
  "devDependencies": {
    "wrangler": "^4.110.0",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.7.3",
    "@cloudflare/workers-types": "^5.20260814.1"
  }
}