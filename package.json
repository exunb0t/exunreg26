{
  "name": "ExunReg26",
  "type": "module",
  "scripts": {
    "dev": "node scripts/exun.js && wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply exunreg26 --local",
    "db:migrate:remote": "wrangler d1 migrations apply exunreg26 --remote"
  },
  "dependencies": {
    "@eoao/nworker-mailer": "^1.2.2",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.13.2",
    "node-html-markdown": "^2.0.0",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.7.3",
    "wrangler": "^4.110.0"
  }
}
